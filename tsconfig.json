{
    "compilerOptions": {
        "allowUnreachableCode": false,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noImplicitAny": true,
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "target": "es2025",
        "declaration": true,
        "types": [
            "jest"
        ]
    },
    "include": [
        "*.ts"
    ],
    "exclude": [
        "node_modules",
        "*.test.ts",
        "lib",
        "dist"
    ]
}
