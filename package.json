{
    "name": "versionpatcher",
    "version": "1.0.0",
    "description": "GitHub Action for patching the version on C# (csproj VS2017+), Node (package.json), Python (setup.py) and others",
    "main": "lib/index.js",
    "types": "lib/index.t.js",
    "type": "module",
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "npx tsc && npx rollup --config rollup.config.js",
        "lint": "npx eslint .",
        "test": "npx jest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/justalemon/VersionPatcher.git"
    },
    "author": "Hannele \"Lemon\" Ruiz",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/justalemon/VersionPatcher/issues"
    },
    "homepage": "https://github.com/justalemon/VersionPatcher#readme",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "@actions/glob": "^0.7.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@octokit/webhooks-types": "^7.6.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "@types/xml2js": "^0.4.14",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-plugin-jest": "^29.16.6",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "rollup": "^4.63.6",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^6.0.2"
    }
}
